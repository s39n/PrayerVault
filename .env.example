# --- PrayerVault configuration ---

# Login credentials. Generate the hash with: python scripts/hash_password.py
AUTH_USERNAME=sean
AUTH_PASSWORD_HASH=

# Random secret for signing session cookies. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# Ollama. Left unset, the compose stack runs a bundled ollama container and the
# app talks to it at http://ollama:11434 (the ollama-pull service downloads the
# models on first start). To use a host or remote Ollama instead, set OLLAMA_URL,
# e.g. http://host.docker.internal:11434 on Docker Desktop.
# OLLAMA_URL=http://ollama:11434
# Keep the model small on CPU-only hosts; 8B models are slow without a GPU.
OLLAMA_MODEL=llama3.2:3b
EMBED_MODEL=nomic-embed-text:latest

# Set to false only if serving plain HTTP on your LAN without Caddy.
COOKIE_SECURE=true

# Host path to the vault prayers folder (used by docker-compose volume)
PRAYERS_DIR=C:/Users/Sean/Documents/SecondBrain/Atlas/Faith & Ministry/Prayers/Prayer Journal

# Public domain for Caddy HTTPS (only needed if using the caddy service)
DOMAIN=prayers.example.com

# --- Optional: morning prayer prompt (ntfy push) ---
# Configured in-app under the "You" tab. NTFY_SERVER only needs setting if you
# self-host ntfy instead of using the public https://ntfy.sh.
# NTFY_SERVER=https://ntfy.sh
