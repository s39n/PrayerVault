# --- PrayerVault configuration ---

# Login credentials. Generate the hash with: python scripts/hash_password.py
AUTH_USERNAME=sean
AUTH_PASSWORD_HASH=

# Random secret for signing session cookies. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# Ollama. Left unset, the compose stack runs a bundled ollama container and the
# app talks to it at http://ollama:11434 (the ollama-pull service downloads the
# models on first start). To use a host or remote Ollama instead, set OLLAMA_URL,
# e.g. http://host.docker.internal:11434 on Docker Desktop.
# OLLAMA_URL=http://ollama:11434
# Keep the model small on CPU-only hosts; 8B models are slow without a GPU.
OLLAMA_MODEL=llama3.2:3b
EMBED_MODEL=nomic-embed-text:latest

# Set to false only if serving plain HTTP on your LAN without Caddy.
COOKIE_SECURE=true

# Host path to the vault prayers folder (used by docker-compose volume)
PRAYERS_DIR=C:/Users/Sean/Documents/SecondBrain/Atlas/Faith & Ministry/Prayers/Prayer Journal

# Public domain for Caddy HTTPS (only needed if using the caddy service)
DOMAIN=prayers.example.com

# --- Optional: morning prayer prompt (ntfy push) ---
# Configured in-app under the "You" tab. NTFY_SERVER only needs setting if you
# self-host ntfy instead of using the public https://ntfy.sh.
# NTFY_SERVER=https://ntfy.sh

# --- Optional: Google sign-in + Google Drive backup ---
# Lets friends/family create their own private prayer journals with a Google
# account (each user gets a folder under USERS_DIR; your vault is untouched),
# and adds a "Back up to Google Drive" button for everyone.
#
# Setup (once, ~5 minutes):
#   1. https://console.cloud.google.com -> create a project (e.g. PrayerVault)
#   2. APIs & Services -> OAuth consent screen -> External -> fill in app name
#      and your email. Add the scopes openid, email, profile, drive.file.
#   3. APIs & Services -> Credentials -> Create credentials -> OAuth client ID
#      -> Web application. Authorized redirect URI (must match exactly):
#         https://<your-domain>/api/auth/google/callback
#   4. Enable the "Google Drive API" under APIs & Services -> Library.
#   5. Paste the client id/secret below. Leave blank to hide Google features.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Public base URL used for the OAuth redirect (defaults to https://$DOMAIN).
# PUBLIC_URL=https://prayers.example.com
# Host folder where Google users' prayers are stored (compose maps it to /users).
USERS_DIR_HOST=./users
